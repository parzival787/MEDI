<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeWidth="1dp"
    app:strokeColor="#E3F2FD"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header with Medicine Name and Remove Button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_cart_medicine_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@+id/btn_remove_item"
                android:layout_marginEnd="12dp"
                android:textColor="#1565C0"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.01"
                tools:text="Paracetamol 500mg" />

            <com.google.android.material.card.MaterialCardView

                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentEnd="true"
                app:cardCornerRadius="22dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFEBEE">

                <ImageButton
                    android:id="@+id/btn_remove_item"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@android:drawable/ic_menu_delete"
                    app:tint="#D32F2F"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Remove Item"
                    android:padding="10dp"
                    />
            </com.google.android.material.card.MaterialCardView>
        </RelativeLayout>

        <!-- Price -->
        <TextView
            android:id="@+id/tv_cart_medicine_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#607D8B"
            android:textSize="14sp"
            android:layout_marginTop="6dp"
            tools:text="₹5.99 each" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E3F2FD"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"/>

        <!-- Quantity Controls and Total -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/quantity_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#E3F2FD">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="4dp">

                    <ImageButton
                        android:id="@+id/btn_decrease_quantity"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@android:drawable/ic_input_delete"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="#1565C0"
                        android:contentDescription="Decrease Quantity" />

                    <TextView
                        android:id="@+id/tv_cart_quantity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#0277BD"
                        android:minWidth="32dp"
                        android:gravity="center"
                        android:layout_marginHorizontal="8dp"/>

                    <ImageButton
                        android:id="@+id/btn_increase_quantity"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@android:drawable/ic_menu_add"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="#1565C0"
                        android:contentDescription="Increase Quantity" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_cart_line_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Total: ₹5.99"
                android:textColor="#1565C0"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.01" />
        </RelativeLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>