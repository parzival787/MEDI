<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#F5F7FA"
    tools:context=".Uploadprescription">

    <!-- Enhanced Title Section -->
    <TextView
        android:id="@+id/tvScreenTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Upload Prescription"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#0277BD"
        android:letterSpacing="0.01"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvScreenSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Select an image and we'll find matching medicines"
        android:textSize="14sp"
        android:textColor="#607D8B"
        android:layout_marginBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvScreenTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Enhanced Select Image Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSelectImage"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:text="📷  Select Prescription Image"
        android:textSize="16sp"
        android:textStyle="bold"
        android:letterSpacing="0.01"
        app:cornerRadius="16dp"
        app:strokeWidth="2dp"
        app:strokeColor="#1E88E5"
        android:textColor="#1E88E5"
        app:rippleColor="#B3E5FC"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvScreenSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Enhanced Image Preview Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardImagePreview"
        android:layout_width="0dp"
        android:layout_height="280dp"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#FFFFFF"
        app:strokeWidth="2dp"
        app:strokeColor="#E3F2FD"
        app:layout_constraintTop_toBottomOf="@id/btnSelectImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp">

            <ImageView
                android:id="@+id/imagePreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:background="#FAFAFA"
                android:contentDescription="Image Preview"/>

            <!-- Placeholder when no image -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:alpha="0.5">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📋"
                    android:textSize="64sp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No image selected"
                    android:textSize="16sp"
                    android:textColor="#90A4AE"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap above to select"
                    android:textSize="13sp"
                    android:textColor="#B0BEC5"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Enhanced OCR Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRunOCR"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:text="🔍  Find Medicines from Image"
        android:textSize="16sp"
        android:textStyle="bold"
        android:letterSpacing="0.01"
        android:enabled="false"
        android:elevation="8dp"
        app:cornerRadius="16dp"
        app:backgroundTint="#1E88E5"
        app:rippleColor="#B3E5FC"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/cardImagePreview"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Enhanced Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBarOcr"
        style="?android:attr/progressBarStyle"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:visibility="gone"
        android:indeterminateTint="#1E88E5"
        android:elevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/btnRunOCR"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"/>

    <!-- Enhanced Results Label -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardResultsLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#E3F2FD"
        app:layout_constraintTop_toBottomOf="@id/progressBarOcr"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvResultsLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✅ Matching Medicines Found:"
            android:textStyle="bold"
            android:textSize="17sp"
            android:textColor="#0277BD"
            android:padding="16dp"
            android:letterSpacing="0.01"/>
    </com.google.android.material.card.MaterialCardView>

    <!-- Enhanced RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewOcrResults"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/cardResultsLabel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/list_item_ocr_result"
        tools:visibility="visible"/>

    <!-- Enhanced No Results Message -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardNoResults"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#FFF3E0"
        app:strokeWidth="2dp"
        app:strokeColor="#FFB74D"
        app:layout_constraintTop_toBottomOf="@id/cardResultsLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️"
                android:textSize="56sp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tvNoResults"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No matching medicines found in inventory."
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#E65100"
                android:gravity="center"
                android:letterSpacing="0.01"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Try another image or check spelling"
                android:textSize="13sp"
                android:textColor="#F57C00"
                android:gravity="center"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>