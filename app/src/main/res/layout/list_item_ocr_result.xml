<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp"
    android:layout_marginBottom="12dp"
    android:layout_marginHorizontal="4dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeWidth="1dp"
    app:strokeColor="#E3F2FD"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header: Name and Price -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_ocr_medicine_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@+id/tv_ocr_medicine_price"
                android:layout_marginEnd="12dp"
                android:textColor="#0277BD"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.01"
                tools:text="Paracetamol 500mg"/>

            <TextView
                android:id="@+id/tv_ocr_medicine_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:textColor="#1565C0"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.01"
                tools:text="₹5.99" />
        </RelativeLayout>

        <!-- Pharmacist Info -->
        <TextView
            android:id="@+id/tv_ocr_pharmacist_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#607D8B"
            android:textSize="14sp"
            android:drawablePadding="6dp"
            tools:text="🏪 Sold by: City Pharmacy" />

        <!-- Stock Info -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#E8F5E9">

            <TextView
                android:id="@+id/tv_ocr_stock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textColor="#2E7D32"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                tools:text="✓ 15 units available" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E3F2FD"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"/>

        <!-- Add to Cart Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ocr_add_to_cart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add to Cart"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                app:icon="@drawable/ic_shopping_cart"
                app:iconSize="20dp"
                app:iconPadding="8dp"
                app:cornerRadius="12dp"
                app:backgroundTint="#1E88E5"/>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>